{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ответ помощника",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "listing_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "total_rub": {
                "type": "integer",
                "minimum": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "listing_ids",
              "total_rub",
              "explanation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "options"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "clarify"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "budget_rub",
                  "city_id",
                  "categories"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "field",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "questions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "no_match"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
