{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Запрос с историей диалога",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "messages"
  ],
  "additionalProperties": false
}
