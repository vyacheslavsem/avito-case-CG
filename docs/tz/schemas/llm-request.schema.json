{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Вызов языковой модели",
  "type": "object",
  "required": ["model", "messages", "response_format"],
  "properties": {
    "model": {"const": "google/gemma-4-31B-it"},
    "messages": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "required": ["role", "content"], "additionalProperties": false,
        "properties": {"role": {"enum": ["system", "user", "assistant"]}, "content": {"type": "string"}}
      }
    },
    "max_tokens": {"type": "integer", "minimum": 1, "maximum": 2000},
    "max_completion_tokens": {"type": "integer", "minimum": 1, "maximum": 2000},
    "temperature": {"type": "number", "minimum": 0, "maximum": 2},
    "top_p": {"type": "number", "minimum": 0, "maximum": 1},
    "stream": {"const": false},
    "n": {"const": 1},
    "reasoning": {
      "type": "object", "required": ["enabled"], "additionalProperties": false,
      "properties": {"enabled": {"const": false}}
    },
    "reasoning_effort": {"const": "none"},
    "response_format": {
      "oneOf": [
        {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"const": "json_object"}}},
        {
          "type": "object", "required": ["type", "json_schema"], "additionalProperties": false,
          "properties": {
            "type": {"const": "json_schema"},
            "json_schema": {
              "type": "object", "required": ["name", "strict", "schema"], "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                "strict": {"const": true},
                "schema": {"type": ["object", "boolean"]}
              }
            }
          }
        }
      ]
    }
  },
  "not": {"required": ["max_tokens", "max_completion_tokens"]},
  "additionalProperties": false
}
