{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Справочник городов",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "enum": [
          "taganrog",
          "rostov-na-donu",
          "azov"
        ]
      },
      "name": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "name"
    ],
    "additionalProperties": false
  }
}
